    {
      "parameters": {
        "jsCode": "const OFFICE_EMAIL = 'office@example.com';\nconst PREFIXES = { 'Departmental Dues': 'DD', 'Handbook': 'HB' };\nconst form = $('Receipt Form').first().json;\nconst student = $('Student Lookup').first().json;\nconst rows = $('Read Register').all().map(function (i) { return i.json; }).filter(function (r) { return r['Receipt No']; });\nconst amount = Number(form['Amount']);\nconst session = String(form['Session']);\nconst sessionShort = session.replace(/\\d{2}(\\d{2})\\/\\d{2}(\\d{2})/, '$1$2');\nconst code = PREFIXES[form['Purpose']] || 'XX';\nconst sameKind = rows.filter(function (r) { return r['Purpose'] === form['Purpose'] && String(r['Session']) === session; });\nconst seq = String(sameKind.length + 1).padStart(4, '0');\nconst receiptNo = 'COM/' + code + '/' + sessionShort + '/' + seq;\nconst date = new Date().toLocaleDateString('en-GB', { timeZone: 'Africa/Lagos' });\nreturn [{ json: {\n  receiptNo: receiptNo, fileName: receiptNo.replace(/\\//g, '-') + '.pdf', date: date, session: session, amount: amount,\n  name: student['Name'], matric: student['Matric No'], level: student['Level'], purpose: form['Purpose'],\n  duplicateNote: '', to: student['Email'] || OFFICE_EMAIL\n} }];"
      },
