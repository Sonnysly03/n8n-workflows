    {
      "parameters": {
        "jsCode": "\nconst row = $input.first().json;\nconst esc = function (s) { return String(s == null ? '' : s).replace(/[&<>\"']/g, function (c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]; }); };\nconst mask = function (n) { const p = String(n || '').trim().split(/\\s+/); return p[0] + ' ' + p.slice(1).map(function (x) { return x[0] + '.'; }).join(' '); };\nconst page = function (body) { return '<!doctype html><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><body style=\"font-family:Arial,sans-serif;max-width:420px;margin:40px auto;padding:0 16px\">' + body + '</body>'; };\nlet html;\nif (row && row['Receipt No']) {\n  html = page('<h2 style=\"color:#1a7f37\">&#10004; Genuine receipt</h2><p><b>Receipt No:</b> ' + esc(row['Receipt No']) + '<br><b>Date:</b> ' + esc(row['Date']) + '<br><b>Student:</b> ' + esc(mask(row['Name'])) + '<br><b>Level:</b> ' + esc(row['Level']) + '<br><b>Purpose:</b> ' + esc(row['Purpose']) + ' (' + esc(row['Session']) + ')<br><b>Amount:</b> &#8358;' + esc(row['Amount']) + '</p><p style=\"color:#666;font-size:12px\">Issued by the College of Medicine office.</p>');\n} else {\n  html = page('<h2 style=\"color:#b42318\">&#10008; Receipt not found</h2><p>No receipt with this number exists in the register. Please contact the office.</p>');\n}\nreturn [{ json: { html: html } }];\n"
      },
