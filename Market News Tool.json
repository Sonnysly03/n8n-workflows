    {
      "parameters": {
        "jsCode": "const query = String($('Tool Input').first().json.query || '');\nconst xml = String($input.first().json.xml || $input.first().json.data || '');\nconst grab = (s, tag) => {\n  const a = s.indexOf('<' + tag + '>');\n  if (a < 0) return '';\n  const b = s.indexOf('</' + tag + '>', a);\n  if (b < 0) return '';\n  return s.slice(a + tag.length + 2, b);\n};\nconst dec = (v) => v.split('&amp;').join('&').split('&lt;').join('<').split('&gt;').join('>').split('&quot;').join('\"').split('&#39;').join(\"'\");\nconst parts = xml.split('<item>').slice(1, 9);\nconst headlines = parts.map(p => ({ headline: dec(grab(p, 'title')), published: grab(p, 'pubDate') }));\nif (!headlines.length) {\n  return [{ json: { found: false, query, note: 'No recent headlines found for this query.' } }];\n}\nreturn [{ json: { found: true, query, retrievedAt: new Date().toISOString(), headlines } }];"
      },
