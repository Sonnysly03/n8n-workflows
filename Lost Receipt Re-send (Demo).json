    {
      "parameters": {
        "jsCode": "const form = $('Resend Form').first().json;\nconst rows = $input.all().map(function (i) { return i.json; }).filter(function (r) { return r['Receipt No']; });\nconst match = rows.filter(function (r) { return r['Purpose'] === form['Purpose'] && String(r['Session']) === String(form['Session']); });\nif (!match.length) {\n  return [{ json: { found: false, matric: form['Matric Number'], purpose: form['Purpose'], session: form['Session'] } }];\n}\nconst r = match[match.length - 1];\nconst today = $now.setZone('Africa/Lagos').toFormat('dd/MM/yyyy');\nreturn [{ json: { found: true, receiptNo: r['Receipt No'], date: r['Date'], name: r['Name'], matric: r['Matric No'], level: r['Level'], purpose: r['Purpose'], session: r['Session'], amount: r['Amount'], duplicateNote: 'DUPLICATE COPY issued ' + today + ' of the original dated ' + r['Date'] + '.' } }];"
      },
      "id": "f4e588e8-a8fa-40c3-a689-0912362b1f22",
